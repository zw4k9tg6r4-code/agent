{
  "name": "@agent/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test"
  },
  "dependencies": {
    "@agent/contracts": "0.0.0",
    "@agent/core": "0.0.0",
    "@agent/policy": "0.0.0",
    "@agent/providers": "0.0.0",
    "@agent/tools": "0.0.0"
  }
}
